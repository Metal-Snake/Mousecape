<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Background agent, registered by the app through SMAppService.agent(plistName:).
     Re-applies the current cape at login, on user switches and on display changes. -->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>io.github.metal-snake.Mousecape.agent</string>
    <key>BundleProgram</key>
    <string>Contents/MacOS/mousecloak</string>
    <key>ProgramArguments</key>
    <array>
        <string>mousecloak</string>
        <string>--listen</string>
    </array>
    <key>AssociatedBundleIdentifiers</key>
    <array>
        <string>io.github.metal-snake.Mousecape</string>
    </array>
    <key>LimitLoadToSessionType</key>
    <string>Aqua</string>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <dict>
        <key>SuccessfulExit</key>
        <false/>
    </dict>
    <key>ProcessType</key>
    <string>Interactive</string>
</dict>
</plist>
